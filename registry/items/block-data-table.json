{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-data-table",
  "type": "registry:block",
  "title": "Data Table",
  "description": "Small operational table with status filtering and row badges.",
  "dependencies": [
    "@base-ui/react",
    "clsx",
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/blocks/DataTableBlock.tsx",
      "type": "registry:block",
      "target": "@/blocks/DataTableBlock.tsx"
    },
    {
      "path": "src/blocks/Blocks.css",
      "type": "registry:file",
      "target": "@/blocks/Blocks.css"
    }
  ],
  "categories": [
    "block",
    "data-display",
    "product-ui"
  ],
  "meta": {
    "baseThemes": {
      "source": "package-and-source-copy",
      "registryName": "data-table",
      "docsRoute": "/blocks/data-table",
      "components": [
        "button",
        "select"
      ],
      "supportsStyles": [
        "bento",
        "shadcn",
        "neo-brutalism",
        "minimal",
        "enterprise",
        "linear",
        "glass",
        "terminal",
        "material",
        "fluent",
        "retro",
        "cyberpunk",
        "editorial",
        "calm",
        "data-dense",
        "playful",
        "luxury",
        "soft-ui",
        "bauhaus",
        "mono"
      ]
    },
    "agent": {
      "summary": "Use Data Table as a ready product UI starting point for data display screens.",
      "whenToUse": [
        "Data Display",
        "Product screen composition",
        "Block-level copy plan"
      ],
      "registryItems": [
        "/registry/items/block-data-table.json",
        "/registry/items/button.json",
        "/registry/items/select.json"
      ],
      "packageInstall": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "import { DataTableBlock } from 'base-themes'"
      ],
      "sourceCopy": [
        "npx base-themes plan block:data-table",
        "fetch /registry/items/block-data-table.json",
        "copy block files",
        "copy required component files from registryItems",
        "copy every registry.style.files entry once"
      ],
      "installPlan": [
        "npx base-themes plan block:data-table",
        "fetch /registry/items/block-data-table.json",
        "copy block files and component registryItems",
        "import base-themes/styles.css once"
      ],
      "verify": [
        "npm run registry:check",
        "npm run tokens:check",
        "npm run lint",
        "npm run build"
      ]
    }
  }
}
