{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-command-palette",
  "type": "registry:block",
  "title": "Command Palette",
  "description": "Quick-action search panel for navigation, product commands, and agent workflows.",
  "dependencies": [
    "@base-ui/react",
    "clsx",
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/blocks/CommandPaletteBlock.tsx",
      "type": "registry:block",
      "target": "@/blocks/CommandPaletteBlock.tsx"
    },
    {
      "path": "src/blocks/Blocks.css",
      "type": "registry:file",
      "target": "@/blocks/Blocks.css"
    }
  ],
  "categories": [
    "block",
    "command",
    "product-ui"
  ],
  "meta": {
    "baseThemes": {
      "source": "package-and-source-copy",
      "registryName": "command-palette",
      "docsRoute": "/blocks/command-palette",
      "components": [
        "button",
        "combobox"
      ],
      "supportsStyles": [
        "bento",
        "shadcn",
        "neo-brutalism",
        "minimal",
        "enterprise",
        "linear",
        "glass",
        "terminal",
        "material",
        "fluent",
        "retro",
        "cyberpunk",
        "editorial",
        "calm",
        "data-dense",
        "playful",
        "luxury",
        "soft-ui",
        "bauhaus",
        "mono"
      ]
    },
    "agent": {
      "summary": "Use Command Palette as a ready product UI starting point for command screens.",
      "whenToUse": [
        "Command",
        "Product screen composition",
        "Block-level copy plan"
      ],
      "registryItems": [
        "/registry/items/block-command-palette.json",
        "/registry/items/button.json",
        "/registry/items/combobox.json"
      ],
      "packageInstall": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "import { CommandPaletteBlock } from 'base-themes'"
      ],
      "sourceCopy": [
        "npx base-themes plan block:command-palette",
        "fetch /registry/items/block-command-palette.json",
        "copy block files",
        "copy required component files from registryItems",
        "copy every registry.style.files entry once"
      ],
      "installPlan": [
        "npx base-themes plan block:command-palette",
        "fetch /registry/items/block-command-palette.json",
        "copy block files and component registryItems",
        "import base-themes/styles.css once"
      ],
      "verify": [
        "npm run registry:check",
        "npm run tokens:check",
        "npm run lint",
        "npm run build"
      ]
    }
  }
}
