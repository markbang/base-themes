{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-dashboard-shell",
  "type": "registry:block",
  "title": "Dashboard Shell",
  "description": "Operational dashboard header with metrics, progress, and health status.",
  "dependencies": [
    "@base-ui/react",
    "clsx",
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/blocks/DashboardShell.tsx",
      "type": "registry:block",
      "target": "@/blocks/DashboardShell.tsx"
    },
    {
      "path": "src/blocks/Blocks.css",
      "type": "registry:file",
      "target": "@/blocks/Blocks.css"
    }
  ],
  "categories": [
    "block",
    "application-ui",
    "product-ui"
  ],
  "meta": {
    "baseThemes": {
      "source": "package-and-source-copy",
      "registryName": "dashboard-shell",
      "docsRoute": "/blocks/dashboard-shell",
      "components": [
        "button",
        "progress",
        "meter"
      ],
      "supportsStyles": [
        "bento",
        "shadcn",
        "neo-brutalism",
        "minimal",
        "enterprise",
        "linear",
        "glass",
        "terminal",
        "material",
        "fluent",
        "retro",
        "cyberpunk",
        "editorial",
        "calm",
        "data-dense",
        "playful",
        "luxury",
        "soft-ui",
        "bauhaus",
        "mono",
        "studio"
      ]
    },
    "agent": {
      "summary": "Use Dashboard Shell as a ready product UI starting point for application ui screens.",
      "whenToUse": [
        "Application UI",
        "Product screen composition",
        "Block-level copy plan"
      ],
      "registryItems": [
        "/registry/items/block-dashboard-shell.json",
        "/registry/items/button.json",
        "/registry/items/progress.json",
        "/registry/items/meter.json"
      ],
      "packageInstall": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "import { DashboardShell } from 'base-themes'"
      ],
      "sourceCopy": [
        "npx base-themes plan block:dashboard-shell",
        "fetch /registry/items/block-dashboard-shell.json",
        "copy block files",
        "copy required component files from registryItems",
        "copy every registry.style.files entry once"
      ],
      "installPlan": [
        "npx base-themes plan block:dashboard-shell",
        "fetch /registry/items/block-dashboard-shell.json",
        "copy block files and component registryItems",
        "import base-themes/styles.css once"
      ],
      "verify": [
        "npm run registry:check",
        "npm run tokens:check",
        "npm run lint",
        "npm run build"
      ]
    }
  }
}
