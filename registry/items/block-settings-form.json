{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-settings-form",
  "type": "registry:block",
  "title": "Settings Form",
  "description": "Workspace settings form with fields, density selection, and switches.",
  "dependencies": [
    "@base-ui/react",
    "clsx",
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/blocks/SettingsForm.tsx",
      "type": "registry:block",
      "target": "@/blocks/SettingsForm.tsx"
    },
    {
      "path": "src/blocks/Blocks.css",
      "type": "registry:file",
      "target": "@/blocks/Blocks.css"
    }
  ],
  "categories": [
    "block",
    "forms",
    "product-ui"
  ],
  "meta": {
    "baseThemes": {
      "source": "package-and-source-copy",
      "registryName": "settings-form",
      "docsRoute": "/blocks/settings-form",
      "components": [
        "fieldset",
        "field",
        "input",
        "select",
        "switch",
        "button"
      ],
      "supportsStyles": [
        "bento",
        "shadcn",
        "neo-brutalism",
        "minimal",
        "enterprise",
        "linear",
        "glass",
        "terminal",
        "material",
        "fluent",
        "retro",
        "cyberpunk",
        "editorial",
        "calm",
        "data-dense",
        "playful",
        "luxury",
        "soft-ui",
        "bauhaus",
        "mono",
        "studio"
      ]
    },
    "agent": {
      "summary": "Use Settings Form as a ready product UI starting point for forms screens.",
      "whenToUse": [
        "Forms",
        "Product screen composition",
        "Block-level copy plan"
      ],
      "registryItems": [
        "/registry/items/block-settings-form.json",
        "/registry/items/fieldset.json",
        "/registry/items/field.json",
        "/registry/items/input.json",
        "/registry/items/select.json",
        "/registry/items/switch.json",
        "/registry/items/button.json"
      ],
      "packageInstall": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "import { SettingsForm } from 'base-themes'"
      ],
      "sourceCopy": [
        "npx base-themes plan block:settings-form",
        "fetch /registry/items/block-settings-form.json",
        "copy block files",
        "copy required component files from registryItems",
        "copy every registry.style.files entry once"
      ],
      "installPlan": [
        "npx base-themes plan block:settings-form",
        "fetch /registry/items/block-settings-form.json",
        "copy block files and component registryItems",
        "import base-themes/styles.css once"
      ],
      "verify": [
        "npm run registry:check",
        "npm run tokens:check",
        "npm run lint",
        "npm run build"
      ]
    }
  }
}
