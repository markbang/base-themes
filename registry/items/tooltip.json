{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tooltip",
  "type": "registry:ui",
  "title": "Tooltip",
  "description": "A small non-interactive label for controls and dense interfaces.",
  "dependencies": [
    "@base-ui/react",
    "clsx",
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/components/ui/Tooltip.tsx",
      "type": "registry:ui",
      "target": "@/components/ui/Tooltip.tsx"
    },
    {
      "path": "src/components/ui/Tooltip.css",
      "type": "registry:file",
      "target": "@/components/ui/Tooltip.css"
    }
  ],
  "categories": [
    "base-ui",
    "component",
    "disclosure",
    "overlay"
  ],
  "meta": {
    "baseThemes": {
      "source": "package-and-source-copy",
      "docsRoute": "/components/tooltip",
      "supportsStyles": [
        "bento",
        "shadcn",
        "neo-brutalism",
        "minimal",
        "enterprise",
        "linear",
        "glass",
        "terminal",
        "material",
        "fluent",
        "retro",
        "cyberpunk",
        "editorial",
        "calm",
        "data-dense",
        "playful",
        "luxury",
        "soft-ui",
        "bauhaus",
        "mono",
        "studio",
        "cohub"
      ],
      "styleContract": [
        "data-style",
        "data-theme",
        "src/index.css",
        "src/styles/tokens.css",
        "src/styles/themes.css",
        "src/styles/shadcn.css",
        "src/styles/neo-brutalism.css",
        "src/styles/cyberpunk.css",
        "src/styles/terminal.css",
        "src/styles/material.css",
        "src/styles/glass.css",
        "src/styles/studio.css",
        "src/styles/cohub.css"
      ]
    },
    "agent": {
      "summary": "Use Tooltip when a React UI needs a small non-interactive label for controls and dense interfaces.",
      "whenToUse": [
        "Disclosure",
        "Base UI wrapper",
        "CSS token theme support"
      ],
      "packageInstall": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "import { Tooltip } from 'base-themes'"
      ],
      "sourceCopy": [
        "fetch /registry/items/tooltip.json",
        "copy every files[].path to files[].target",
        "copy every registry.style.files entry once",
        "install dependencies from dependencies[]"
      ],
      "installPlan": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "import { Tooltip } from 'base-themes'",
        "or fetch /registry/items/tooltip.json for source-copy"
      ],
      "verify": [
        "npm run registry:check",
        "npm run tokens:check",
        "npm run lint",
        "npm run build"
      ]
    }
  }
}
