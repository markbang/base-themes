{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "block-auth-card",
  "type": "registry:block",
  "title": "Auth Card",
  "description": "Focused sign-in card with email, password, remembered device, and SSO action.",
  "dependencies": [
    "@base-ui/react",
    "clsx",
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/blocks/AuthCard.tsx",
      "type": "registry:block",
      "target": "@/blocks/AuthCard.tsx"
    },
    {
      "path": "src/blocks/Blocks.css",
      "type": "registry:file",
      "target": "@/blocks/Blocks.css"
    }
  ],
  "categories": [
    "block",
    "authentication",
    "product-ui"
  ],
  "meta": {
    "baseThemes": {
      "source": "package-and-source-copy",
      "registryName": "auth-card",
      "docsRoute": "/blocks/auth-card",
      "components": [
        "button",
        "field",
        "input",
        "separator",
        "switch"
      ],
      "supportsStyles": [
        "bento",
        "shadcn",
        "neo-brutalism",
        "minimal",
        "enterprise",
        "linear",
        "glass",
        "terminal",
        "material",
        "fluent",
        "retro",
        "cyberpunk",
        "editorial",
        "calm",
        "data-dense",
        "playful",
        "luxury",
        "soft-ui",
        "bauhaus",
        "mono",
        "studio",
        "cohub"
      ]
    },
    "agent": {
      "summary": "Use Auth Card as a ready product UI starting point for authentication screens.",
      "whenToUse": [
        "Authentication",
        "Product screen composition",
        "Block-level copy plan"
      ],
      "registryItems": [
        "/registry/items/block-auth-card.json",
        "/registry/items/button.json",
        "/registry/items/field.json",
        "/registry/items/input.json",
        "/registry/items/separator.json",
        "/registry/items/switch.json"
      ],
      "packageInstall": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "import { AuthCard } from 'base-themes'"
      ],
      "sourceCopy": [
        "npx base-themes plan block:auth-card",
        "fetch /registry/items/block-auth-card.json",
        "copy block files",
        "copy required component files from registryItems",
        "copy every registry.style.files entry once"
      ],
      "installPlan": [
        "npx base-themes plan block:auth-card",
        "fetch /registry/items/block-auth-card.json",
        "copy block files and component registryItems",
        "import base-themes/styles.css once"
      ],
      "verify": [
        "npm run registry:check",
        "npm run tokens:check",
        "npm run lint",
        "npm run build"
      ]
    }
  }
}
