{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-studio",
  "type": "registry:theme",
  "title": "Studio Theme",
  "description": "Neta Studio style with graphite panels, cream controls, fine-line borders, and restrained teal status accents.",
  "files": [
    {
      "path": "src/index.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/index.css"
    },
    {
      "path": "src/styles/tokens.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/tokens.css"
    },
    {
      "path": "src/styles/themes.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/themes.css"
    },
    {
      "path": "src/styles/shadcn.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/shadcn.css"
    },
    {
      "path": "src/styles/neo-brutalism.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/neo-brutalism.css"
    },
    {
      "path": "src/styles/cyberpunk.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/cyberpunk.css"
    },
    {
      "path": "src/styles/terminal.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/terminal.css"
    },
    {
      "path": "src/styles/material.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/material.css"
    },
    {
      "path": "src/styles/glass.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/glass.css"
    },
    {
      "path": "src/styles/studio.css",
      "type": "registry:file",
      "target": "@/styles/base-themes/studio.css"
    }
  ],
  "categories": [
    "theme",
    "base-themes"
  ],
  "meta": {
    "preview": {
      "light": "/previews/base-themes-studio.png"
    },
    "baseThemes": {
      "style": "studio",
      "label": "Studio",
      "defaultMode": "light",
      "supportsModes": [
        "light",
        "dark"
      ],
      "dataAttributes": {
        "style": "studio",
        "theme": "light"
      }
    },
    "agent": {
      "summary": "Use the Studio theme when the user wants neta studio style with graphite panels, cream controls, fine-line borders, and restrained teal status accents.",
      "whenToUse": [
        "Studio",
        "CSS variable theme",
        "Base Themes visual style"
      ],
      "avoidWhen": [
        "The user needs a fully custom brand system before trying token overrides"
      ],
      "packageInstall": [
        "npm install base-themes @base-ui/react react react-dom",
        "import base-themes/styles.css once",
        "set data-style=\"studio\"",
        "set data-theme=\"light\" or data-theme=\"dark\""
      ],
      "sourceCopy": [
        "fetch /registry/items/theme-studio.json",
        "copy every files[].path to files[].target",
        "copy src/styles/tokenContract.json when generating overrides"
      ],
      "installPlan": [
        "import base-themes/styles.css once",
        "set data-style=\"studio\"",
        "set data-theme=\"light\" or data-theme=\"dark\"",
        "or fetch /registry/items/theme-studio.json for source-copy"
      ],
      "prompts": [
        "Create a React settings screen using Base Themes with data-style=\"studio\"."
      ]
    }
  }
}
