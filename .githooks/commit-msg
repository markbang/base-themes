#!/usr/bin/env sh
set -eu

commit_msg_file="$1"
first_line="$(sed -n '1p' "$commit_msg_file")"

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

conventional_commit_pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([A-Za-z0-9._/-]+\))?!?: .+'

if ! printf '%s\n' "$first_line" | grep -Eq "$conventional_commit_pattern"; then
  cat >&2 <<'EOF'
Invalid commit message.

Commit messages must follow Conventional Commits:
  <type>[optional scope][!]: <description>

Examples:
  feat(themes): add expanded theme styles
  ci: use OIDC npm publishing workflow
  fix!: remove deprecated theme token

Allowed types:
  build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test

Spec: https://www.conventionalcommits.org/en/v1.0.0/
EOF
  exit 1
fi
